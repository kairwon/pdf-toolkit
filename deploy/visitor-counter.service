[Unit]
Description=Lab of PDF local API and feedback collector
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/labofpdf-api/server.mjs
Restart=always
RestartSec=5
User=www-data
Group=www-data
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=FEEDBACK_DB_PATH=/var/lib/labofpdf/feedback.sqlite3
Environment=COUNTERS_PATH=/var/lib/labofpdf/counters.json
Environment=WORD_CONVERTER_BIN=/usr/bin/libreoffice
Environment=WORD_CONVERSION_TIMEOUT_MS=60000
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/labofpdf
MemoryMax=700M
TasksMax=128

[Install]
WantedBy=multi-user.target
